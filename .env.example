# Puertos locales aislados (para no chocar con otros proyectos)
FRONTEND_PORT=5175
BACKEND_PORT=8005
DB_PORT=5435

# Base de datos PostgreSQL
POSTGRES_USER=epp_admin
POSTGRES_PASSWORD=cambia_esta_clave_segura_123
POSTGRES_DB=epp_marcaje_db
DATABASE_URL=postgresql+psycopg://epp_admin:cambia_esta_clave_segura_123@db:5432/epp_marcaje_db

# Seguridad JWT (generar con: openssl rand -hex 32)
SECRET_KEY=genera_una_clave_secreta_larga_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Entorno y CORS
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5175
